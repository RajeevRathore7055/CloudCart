# Copy this file to .env and fill real values. NEVER commit .env
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=cloudcart
DATABASE_USER=cloudcart_user
DATABASE_PASSWORD=change_me
SECRET_KEY=change_me_to_a_long_random_string

# Admin account created by scripts/init_db.py
ADMIN_EMAIL=admin@cloudcart.com
ADMIN_PASSWORD=Admin@123

# Set true only when site is served over HTTPS (CloudFront/ALB with certificate)
COOKIE_SECURE=false

# AWS (leave empty for local run)
AWS_REGION=
S3_BUCKET_NAME=
# Optional: CloudFront domain, e.g. https://d1234abcd.cloudfront.net
IMAGE_BASE_URL=
